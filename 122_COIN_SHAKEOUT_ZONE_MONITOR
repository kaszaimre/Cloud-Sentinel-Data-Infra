import time
from datetime import datetime

def check_shakeout_zone(current_price, support_level, resistance_level):
    """
    Meghatározza, hogy az árfolyam a veszélyes kirázási zónában van-e.
    A zóna a támasz és ellenállás körüli 1.5%-os sáv.
    """
    # 1.5%-os puffer zóna kiszámítása a stop-hunting észleléséhez
    buffer_pct = 0.015
    
    in_lower_shakeout = support_level * (1 - buffer_pct) <= current_price <= support_level * (1 + buffer_pct)
    in_upper_shakeout = resistance_level * (1 - buffer_pct) <= current_price <= resistance_level * (1 + buffer_pct)
    
    if in_lower_shakeout:
        return "[WARN] [ANOMÁLIA] Alsó kirázási zóna! Stop-vadászat lehetséges."
    elif in_upper_shakeout:
        return "[WARN] [ANOMÁLIA] Felső kirázási zóna! Likviditási csapda."
    else:
        return "[OK] Stabil zóna, nincs aktív kirázás."

