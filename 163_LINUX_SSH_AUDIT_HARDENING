import time
from datetime import datetime

def run_ssh_hardening_audit(config_mock):
    """
    Tiszta logikával végigmegy az SSH konfigurációs kulcsokon,
    és jelzi a biztonsági réseket.
    """
    timestamp = datetime.now().strftime("%H:%M:%S")
    print(f"[{timestamp}] [INFO] SSH konfigurációs audit indítása...")
    time.sleep(0.5)
    
    risk_score = 0
    recommendations = []
    
    # 1. Root belépés ellenőrzése
    if config_mock.get("PermitRootLogin") == "yes":
        risk_score += 40
        recommendations.append("[🚨 CRITICAL] PermitRootLogin beállítása 'no' kell legyen!")
        
    # 2. Sima jelszavas belépés ellenőrzése
    if config_mock.get("PasswordAuthentication") == "yes":
        risk_score += 30
        recommendations.append("[⚠️ WARN] PasswordAuthentication letiltása javasolt (csak SSH kulcs)!")
        
    # 3. Port ellenőrzése (A gyári 22-es portot a botok állandóan támadják)
    if config_mock.get("Port") == 22:
        risk_score += 20
        recommendations.append("[💡 INFO] Az SSH port átrakása javasolt a gyári 22-esről egy egyedi portra.")
        
    return risk_score, recommendations

if __name__ == "__main__":
    print("=== 064_linux_ssh_audit_hardening INDÍTÁSA ===")
