import time

class TrafficShaper:
    def __init__(self, max_mbps=100):
        self.max_mbps = max_mbps
        self.active_conns = {}

    def inspect_packet(self, source_ip, data_size):
        """Vizsgálja a csomagot és korlátozza, ha szükséges."""
        print(f"[*] Forgalom elemzése: {source_ip} | Méret: {data_size}MB")
        
        # Egyszerű throttle logika
        if data_size > 50:  # Ha egy csomag túl nagy, throttling lép életbe
            print(f"[!] FIGYELMEZTETÉS: {source_ip} túllépte a keretet! Korlátozás...")
            return False, "Throttled"
        
        return True, "Passed"

if __name__ == "__main__":
    shaper = TrafficShaper()
    # Szimulált forgalom
    result, msg = shaper.inspect_packet("192.168.1.105", 75)
    print(f"Státusz: {result}, Üzenet: {msg}")
