import time
from datetime import datetime

def calculate_slippage(requested_price, execution_price, asset_name):
    """
    Kiszámolja a csúszás mértékét dollárban és százalékban.
    """
    slippage_usd = execution_price - requested_price
    slippage_pct = (slippage_usd / requested_price) * 100
    
    return slippage_usd, slippage_pct

