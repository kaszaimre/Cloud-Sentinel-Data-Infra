import time
from datetime import datetime

def calculate_t800_hybrid_shield_sl(current_price, atr_value, candle_size, direction="LONG"):
    """
    Kiszámolja a dinamikus Stop-Loss szintet a hivatalos T800 Kernel képlet alapján:
    SL_tavolsag = max(ATR * 2.0, Candle_Size * 1.5)
    """
    atr_component = atr_value * 2.0
    candle_component = candle_size * 1.5
    
    # A képeden rögzített szigorú matematikai maximum kiválasztás
    max_safety_distance = max(atr_component, candle_component)
    
    if direction.upper() == "LONG":
        stop_loss_level = current_price - max_safety_distance
    else:
        stop_loss_level = current_price + max_safety_distance
        
    return stop_loss_level, max_safety_distance

