"""
================================================================================
PROJEKT: 163_GOOGL_Monte_Carlo_T-800 Szimulációs Motor
module_desc = """ 

LEÍRÁS (HU): 
    
Geometriai Brown-mozgás (GBM) alapú árfolyam-előrejelzés 1 éves 
időhorizonton, 1000 szimulációs útvonallal.
Mottó: A borsodi nem hackel, a borsodi optimalizál.

DESCRIPTION (EN):
    
Geometric Brownian Motion (GBM) based price projection over a 1-year 
time horizon using 1000 simulation paths.
Motto: The Borsodi doesn't hack, the Borsodi optimizes. 

STRATÉGIA: A volatilitás és a várható növekedés (mu, sigma) alapú statisztikai 
           kockázatbecslés a 'Borsodi War Room' operációs protokoll szerint.

SZERZŐ: Don Mérnök (Tábornok) | BORSODI WAR ROOM """
# ==============================================================================

import numpy as np
import matplotlib.pyplot as plt

# --- 1. PARAMÉTEREK BEÁLLÍTÁSA ---
start_ar = 358.16      # Aktuális árfolyam / Current price
idohorizont = 252       # 1 év kereskedési napjai / Trading days in 1 year
szimulaciok = 1000      # 1000 futtatás a pontos statisztikáért / Number of simulations

mu = 0.15              # Elemzői konszenzus szerinti várt éves növekedés (15%) / Expected annual growth
sigma = 0.22           # Évesített történeti volatilitás (22%) / Annualized historical volatility
dt = 1 / idohorizont

# --- 2. SZIMULÁCIÓS MOTOR INDÍTÁSA ---
plt.figure(figsize=(10, 6))
vegeredmenyek = []

for i in range(szimulaciok):
    # Véletlenszerű piaci sokkok generálása (Normális eloszlás) / Generate random market shocks
    sokkok = np.random.normal(0, np.sqrt(dt), idohorizont)
    
    # Geometriai Brown-mozgás kiszámítása / Calculate Geometric Brownian Motion
    növekedés = (mu - 0.5 * sigma**2) * dt + sigma * sokkok
    ar_görbe = start_ar * np.exp(np.cumsum(növekedés))
    
    vegeredmenyek.append(ar_görbe[-1])
    plt.plot(ar_görbe, color='gray', alpha=0.1)

# --- 3. JELENTÉS ÉS STATISZTIKÁK ---
atlag_ar = np.mean(vegeredmenyek)
bika_ar = np.percentile(vegeredmenyek, 95)   # 95%-os optimista eset / 95th percentile (optimistic)
medve_ar = np.percentile(vegeredmenyek, 5)    # 5%-os pesszimizmus / 5th percentile (pessimistic)

print("=== T-800 SZIMULÁCIÓS JELENTÉS ===")
print(f"Várható átlagos ár 1 év múlva: ${atlag_ar:.2f}")
print(f"Bika szcenárió (Top 5%):       ${bika_ar:.2f}")
print(f"Medve szcenárió (Alsó 5%):     ${medve_ar:.2f}")

# --- 4. GRAFIKON MEGJELENÍTÉSE ---
plt.axhline(y=start_ar, color='black', linestyle='-', label=f'Induló Ár ({start_ar})')
plt.axhline(y=atlag_ar, color='blue', linestyle='--', linewidth=2, label=f'Átlagos kimenet ({atlag_ar:.2f})')
plt.title(f'GOOGL 1 Éves Kivetítés - {szimulaciok} Monte Carlo Útvonal')
plt.xlabel('Kereskedési Napok / Trading Days')
plt.ylabel('Árfolyam (USD) / Price (USD)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()
