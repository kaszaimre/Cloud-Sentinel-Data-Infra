import time
from datetime import datetime

def evaluate_macro_trend(spx_close, spx_ema_200):
    """
    Tiszta logikájú makro-szűrő a manuálisan megadott értékek alapján.
    """
    if spx_close > spx_ema_200:
        return "BULLISH", "🟢 GLOBÁLIS EMELKEDŐ TREND - Kereskedés engedélyezve."
    elif spx_close < spx_ema_200:
        return "BEARISH", "🔴 GLOBÁLIS CSÖKKENŐ TREND - Fokozott kockázat, védelem aktív."
    else:
        return "NEUTRAL", "🟡 OLDALAZÓ PIAC - Kivárás javasolt."

